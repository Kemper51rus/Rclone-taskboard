[Unit]
Description=Rclone taskboard backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/rclone-taskboard/taskboard/backend
Environment=TASKBOARD_BACKEND_HOST=127.0.0.1
Environment=TASKBOARD_BACKEND_PORT=8081
EnvironmentFile=-/opt/rclone-taskboard/taskboard/.env
ExecStart=/bin/sh -c 'exec /opt/rclone-taskboard/taskboard/.venv/bin/python3 -m uvicorn app.main:app --host "$TASKBOARD_BACKEND_HOST" --port "$TASKBOARD_BACKEND_PORT"'
Restart=always
RestartSec=3
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
