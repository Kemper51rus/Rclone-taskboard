# Experimental Next frontend static service. Defaults are set in the systemd unit.
# It is safe to stop this service without affecting backend or the current frontend.
#
# TASKBOARD_FRONTEND_HOST=0.0.0.0
# TASKBOARD_FRONTEND_PORT=8090
# TASKBOARD_FRONTEND_API_PROXY_URL=http://127.0.0.1:8081
# TASKBOARD_FRONTEND_STATIC_ROOT=/opt/rclone-taskboard/taskboard/frontend-next/static
# TASKBOARD_FRONTEND_PROXY_TIMEOUT=60
