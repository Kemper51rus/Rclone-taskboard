TASKBOARD_APP_NAME=rclone-taskboard
APP_ROOT=/opt/rclone-taskboard/taskboard/backend
TASKBOARD_BACKEND_HOST=127.0.0.1
TASKBOARD_BACKEND_PORT=8081
TASKBOARD_DB_PATH=/opt/rclone-taskboard/taskboard/data/taskboard.db
TASKBOARD_JOBS_FILE=/opt/rclone-taskboard/taskboard/backend/app/jobs/default_jobs.json
TASKBOARD_RCLONE_CONFIG=/root/.config/rclone/rclone.conf
APP_TIMEZONE=Europe/Moscow
TASKBOARD_ENABLE_SCHEDULER=true
TASKBOARD_STANDARD_INTERVAL_MINUTES=1
TASKBOARD_HEAVY_HOUR=3
TASKBOARD_WATCHER_DEBOUNCE_SECONDS=45
TASKBOARD_COPY_STARTUP_DELAY_SECONDS=60
TASKBOARD_COPY_MIN_START_INTERVAL_SECONDS=60
TASKBOARD_DEFAULT_TIMEOUT_SECONDS=3600
TASKBOARD_OUTPUT_TAIL_CHARS=8000
TASKBOARD_DRY_RUN=false
# For browser clients that call the backend directly instead of using the frontend /api proxy.
# TASKBOARD_CORS_ORIGINS=http://frontend-lxc:8080,http://localhost:8080
# TASKBOARD_API_TOKEN=change-me
