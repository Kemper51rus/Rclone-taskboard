# Frontend static service. Defaults are set in the systemd unit.
# Uncomment only when you need to override ports or point the frontend to a remote backend.
#
# TASKBOARD_FRONTEND_HOST=0.0.0.0
# TASKBOARD_FRONTEND_PORT=8080
# TASKBOARD_FRONTEND_API_PROXY_URL=http://127.0.0.1:8081
# TASKBOARD_FRONTEND_STATIC_ROOT=/opt/rclone-taskboard/taskboard/frontend/static
# TASKBOARD_FRONTEND_PROXY_TIMEOUT=60
